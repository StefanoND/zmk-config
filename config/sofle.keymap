#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/outputs.h>

// For a list of available locales, check the link below
// https://github.com/joelspadin/zmk-locales/tree/main/include/locale
#include <locale/keys_pt.h>

#define BASE   0
#define LOWER  1
#define RAISE  2
#define ADJUST 3

//Encoder Support
//Alps Alpine EC11N1524402: 30 Detent, 15PPR, 2 Channel, Quadrature, 15000 Cycle
/ {
    left_encoder: encoder_left {
        compatible = "alps,ec11";
        a-gpios = <&pro_micro 21 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&pro_micro 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <40>;
    };
    right_encoder: encoder_right {
        compatible = "alps,ec11";
        a-gpios = <&pro_micro 21 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&pro_micro 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <40>;
    };
    sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&left_encoder &right_encoder>;
        triggers-per-rotation = <5>;
    };
};

/ {
   // Activate ADJUST layer by pressing raise and lower
    conditional_layers {
        compatible = "zmk,conditional-layers";
        adjust_layer {
            if-layers = <LOWER RAISE>;
            then-layer = <ADJUST>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "default";
            // -----------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2   |  3   |   4   |   5   |                      |   6   |   7   |   8   |  9   |  0  | BKSPC |
            // |   \   |  Q  |  W   |  E   |   R   |   T   |                      |   Y   |   U   |   I   |  O   |  P  |   '   |
            // |  TAB  |  A  |  S   |  D   |   F   |   G   |                      |   H   |   J   |   K   |  L   |  ç  |   ~   |
            // | SHIFT |  Z  |  X   |  C   |   V   |   B   |   MUTE  |  |  PLAY   |   N   |   M   |   ,   |  .   |  -  |   <   |
            //               | CTRL | META |  ALT  | SPACE |  LOWER  |  |  RAISE  | ENTER |   º   |  ALT  | CTRL |
            bindings = <
&kp ESC      &kp PT_N1  &kp PT_N2  &kp PT_N3  &kp PT_N4  &kp PT_N5                         &kp PT_N6  &kp PT_N7    &kp PT_N8     &kp PT_N9   &kp PT_N0         &kp BSPC
&kp PT_BSLH  &kp PT_Q   &kp PT_W   &kp PT_E   &kp PT_R   &kp PT_T                          &kp PT_Y   &kp PT_U     &kp PT_I      &kp PT_O    &kp PT_P          &kp PT_SINGLE_QUOTE
&kp TAB      &kp PT_A   &kp PT_S   &kp PT_D   &kp PT_F   &kp PT_G                          &kp PT_H   &kp PT_J     &kp PT_K      &kp PT_L    &kp PT_C_CEDILLA  &kp PT_TILDE
&kp LSHFT    &kp PT_Z   &kp PT_X   &kp PT_C   &kp PT_V   &kp PT_B   &kp C_MUTE  &kp C_PP   &kp PT_N   &kp PT_M     &kp PT_COMMA  &kp PT_DOT  &kp PT_MINUS      &kp PT_LESS_THAN
                        &kp LCTRL  &kp LGUI   &kp LALT   &kp SPACE  &mo LOWER   &mo RAISE  &kp RET    &kp PT_ORDM  &kp RALT      &kp RCTRL
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp PG_DN PG_UP>;
        };

        lower_layer {
            display-name = "lower";
            // -------------------------------------------------------------------------------------------------------------
            // |       | PSCRN |  ^  |   |   |   &   |       |                |      | NUMLK |   /   |   *   |   -   |  DEL  |
            // |       |  GUI  |  #  |   (   |   )   |   =   |                |  *   |   7   |   8   |   9   |   +   |       |
            // |       | SCROL |  %  |   {   |   }   |   /   |                |  -   |   4   |   5   |   6   |   +   |       |
            // | CAPSL |       |  @  |   [   |   ]   |   !   |       |  |     |  +   |   1   |   2   |   3   |   =   |       |
            //                 |     |       |       |       |       |  |     |      |   0   |   0   |   .   |
            bindings = <
&trans    &kp PSCRN    &kp PT_CARET  &kp PT_PIPE   &kp PT_AMPS  &trans                        &trans        &kp KP_NUM  &kp KP_DIVIDE  &kp KP_MULTIPLY  &kp KP_MINUS  &kp DEL
&trans    &kp K_CMENU  &kp PT_HASH   &kp PT_LPAR   &kp PT_RPAR  &kp PT_EQUAL                  &kp PT_STAR   &kp KP_N7   &kp KP_N8      &kp KP_N9        &kp KP_PLUS   &trans
&trans    &kp SLCK     &kp PT_PRCNT  &kp PT_LBRC   &kp PT_RBRC  &kp PT_FSLH                   &kp PT_MINUS  &kp KP_N4   &kp KP_N5      &kp KP_N6        &kp KP_PLUS   &trans
&kp CAPS  &trans       &kp PT_AT     &kp PT_LBKT   &kp PT_RBKT  &kp PT_EXCL   &trans  &trans  &kp PT_PLUS   &kp KP_N1   &kp KP_N2      &kp KP_N3        &kp PT_EQUAL  &trans
                       &trans        &trans        &trans       &trans        &trans  &trans  &trans        &kp KP_N0   &kp KP_N0      &kp KP_DOT
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp C_NEXT C_PREV>;
        };

        raise_layer {
            display-name = "raise";
            // -------------------------------------------------------------------------------------------------------------
            // |       |  F1  |  F2  |  F3   |  F4   |  F5  |                |  F6  |   F7   |  F8  |  F9  |  F10  |  DEL  |
            // |       | INS  | PSCR | GUI   |       | BRI+ |                | HOME |  PGUP  | VOL+ | NEXT |  F11  |  F12  |
            // |       | ALT  | CTRL | SHIFT |       | BRI- |                |     |       |     |     |       |       |
            // |       | UNDO | CUT  | COPY  | PASTE | MUTE |      |  |      | END  |  PGDN  | VOL- | PREV |       |       |
            //                |      |       |       |      |      |  |      |      |        |      |      |
            bindings = <
&trans      &kp F1      &kp F2     &kp F3       &kp F4       &kp F5                        &kp F6    &kp F7     &kp F8        &kp F9      &kp F10  &kp DEL
&trans      &kp INS     &kp PSCRN  &kp K_CMENU  &trans       &kp C_BRI_UP                  &kp HOME  &kp PG_UP  &kp C_VOL_UP  &kp C_NEXT  &kp F11  &kp F12
&trans      &kp LALT    &kp LCTRL  &kp LSHFT    &trans       &kp C_BRI_DN                  &kp LEFT  &kp DOWN   &kp UP        &kp RIGHT   &trans   &trans
&kp K_REDO  &kp K_UNDO  &kp K_CUT  &kp K_COPY   &kp K_PASTE  &kp C_MUTE    &trans  &trans  &kp END   &kp PG_DN  &kp C_VOL_DN  &kp C_PREV  &trans   &trans
                        &trans     &trans       &trans       &trans        &trans  &trans  &trans    &trans     &trans        &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp C_NEXT C_PREV>;
        };

        adjust_layer {
            display-name = "adjust";
            // ---------------------------------------------------------------------------------------------------------------------------
            // | BTCLR  | BT1  | BT2  | BT3  | BT4  |   BT5   |                  |   BT6   |   BT7   |  BT8  |  BT9  |  BT10  | BTCLRALL |
            // | EXTPWR | HUE- | HUE+ | SAT- | SAT+ | EFFECT+ |                  | OUT_USB |         |       |       |        |          |
            // |        | BRI- | BRI+ |      |      | EFFECT- |                  | OUT_USB | OUT_TOG |       |       |        |          |
            // |        |      |      |      |      |         | RGB_TOG | |      | OUT_BLE |         |       |       |        |          |
            //                 |      |      |      |         |         | |      |         |         |       |       |
            bindings = <
&bt BT_CLR        &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3    &bt BT_SEL 4                             &bt BT_SEL 5 &bt BT_SEL 6 &bt BT_SEL 7 &bt BT_SEL 8 &bt BT_SEL 9 &bt BT_CLR_ALL
&ext_power EP_TOG &rgb_ug RGB_HUD &rgb_ug RGB_HUI &rgb_ug RGB_SAD &rgb_ug RGB_SAI &rgb_ug RGB_EFF                          &trans       &trans       &trans       &trans       &trans       &trans
&trans            &rgb_ug RGB_BRD &rgb_ug RGB_BRI &trans          &trans          &rgb_ug RGB_EFR                          &out OUT_USB &out OUT_TOG &trans       &trans       &trans       &trans
&trans            &trans          &trans          &trans          &trans          &trans           &rgb_ug RGB_TOG &trans  &out OUT_BLE &trans       &trans       &trans       &trans       &trans
                                  &trans          &trans          &trans          &trans           &trans          &trans  &trans       &trans       &trans       &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp C_NEXT C_PREV>;
        };
    };
};
